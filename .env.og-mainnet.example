# Copy to .env.og-mainnet.local (USDC.e deployment) or .env.og-mainnet-usdz.local (USDZ deployment)
# and chmod 600. Never commit the local file. PERPDEX_NETWORK must be exported in the shell,
# not set here: PERPDEX_NETWORK=og-mainnet | og-mainnet-usdz.
# RPC endpoint (operator environment / secret store only; never commit a credentialed URL).
PERPDEX_OG_MAINNET_RPC_URL=
OG_MAINNET_CHAIN_ID=16661
# No deployer private key: the mainnet deployer is a Fordefi custody wallet (pending creation).
# Operator-fill once the Fordefi deployer wallet exists:
PERPDEX_DEPLOYER_ADDRESS=0xREPLACE_WITH_FORDEFI_DEPLOYER_ADDRESS
# Pinned in scripts/deployment-config.ts; any other value is refused.
PERPDEX_SEQUENCER_ADDRESS=0x2a83BE9CC98d70c20EAC0d8c35b1D035B2741C59 # gitleaks:allow -- public address
# Operator-fill: requires a reviewed config/og-mainnet.fee-policy.json first.
PERPDEX_OG_MAINNET_GAS_PRICE_WEI=
PERPDEX_DEPLOYMENT_NONCE=
PERPDEX_FIRST_TRANSACTION_NONCE=
PERPDEX_RELEASE_EXPIRES_AT=0
# Defaults resolve from the selected profile; listed for the og-mainnet (USDC.e) deployment.
PERPDEX_VERIFIER_PUBLIC_KEYS_FILE=./config/og-mainnet.verifier-public-keys.json
PERPDEX_PRODUCTS_FILE=./config/og-mainnet.products.json
PERPDEX_PRODUCT_REVIEW_FILE=./config/og-mainnet.product-approval-review.json
PERPDEX_DEPLOYMENT_INTENT_FILE=./config/og-mainnet.deployment-intent.local.json
PERPDEX_STORK_SNAPSHOT_FILE=./config/og-mainnet.stork-deployment-snapshot.local.json
PERPDEX_ADDRESS_PLAN_FILE=./deployments/16661/og-mainnet/address-plan.local.json
PERPDEX_PREPARED_DEPLOYMENT=./deployments/16661/og-mainnet/prepared.local.json
PERPDEX_FINALIZATION_JOURNAL=./deployments/16661/og-mainnet/finalization.local.json
PERPDEX_DEPLOYMENT_MANIFEST=./deployments/16661/og-mainnet/latest.local.json
