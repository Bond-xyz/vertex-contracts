# Copy to .env.galileo.local and chmod 600. Never commit the local file.
GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai
GALILEO_CHAIN_ID=16602
PERPDEX_GALILEO_DEPLOYER_PRIVATE_KEY=0xREPLACE_WITH_TESTNET_KEY
# Explicit reviewed legacy fee. Deployment fails closed when this is missing or out of bounds.
PERPDEX_GALILEO_GAS_PRICE_WEI=4000000007
PERPDEX_SEQUENCER_ADDRESS=0xREPLACE_WITH_SEQUENCER_ADDRESS
PERPDEX_DEPLOYER_ADDRESS=0xREPLACE_WITH_DEPLOYER_ADDRESS
PERPDEX_DEPLOYMENT_NONCE=1
PERPDEX_FIRST_TRANSACTION_NONCE=0
PERPDEX_ADDRESS_PLAN_FILE=./deployments/16602/address-plan.local.json
PERPDEX_RELEASE_EXPIRES_AT=0
PERPDEX_QUOTE_TOKEN_ADDRESS=0xF2506aa3684871549083d235453a1dcDcCB3396c # gitleaks:allow -- public ERC-20
PERPDEX_VERIFIER_PUBLIC_KEYS_FILE=./config/galileo.verifier-public-keys.local.json
PERPDEX_PRODUCTS_FILE=./config/galileo.products.json
PERPDEX_PRODUCT_REVIEW_FILE=./config/galileo.product-approval-review.json
PERPDEX_RED_APPROVAL_FILE=./config/galileo.red-testnet-approval.json
PERPDEX_DEPLOYMENT_INTENT_FILE=./config/galileo.deployment-intent.local.json
PERPDEX_STORK_RAW_RESPONSE_FILE=./config/galileo.stork-raw-response.local.json
PERPDEX_STORK_OBSERVATION_BLOCK_FILE=./config/galileo.stork-observation-block.local.json
PERPDEX_STORK_SNAPSHOT_FILE=./config/galileo.stork-deployment-snapshot.local.json
PERPDEX_PREPARED_DEPLOYMENT=./deployments/16602/prepared.local.json
PERPDEX_FINALIZATION_JOURNAL=./deployments/16602/finalization.local.json
PERPDEX_DEPLOYMENT_MANIFEST=./deployments/16602/latest.local.json
